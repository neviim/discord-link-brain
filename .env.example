# ---------------------------------------------------------------- Discord ---
# Bot: crie a aplicação em https://discord.com/developers/applications,
# adicione um Bot, ative "Message Content Intent" e convide-o para o servidor
# com as permissões View Channel + Read Message History.
DISCORD_TOKEN=
DISCORD_TOKEN_TYPE=bot

# Ids dos canais (Discord → Configurações → Avançado → Modo desenvolvedor,
# depois botão direito no canal → Copiar ID). Separados por vírgula.
DISCORD_CHANNEL_IDS=

# Opcional: apelido legível por canal, usado no nome dos arquivos.
# Formato: id:nome,id:nome
DISCORD_CHANNEL_NAMES=

# --------------------------------------------------------------- Obsidian ---
OBSIDIAN_VAULT=~/Documents/00_Obsidian-dotcom/dotcom
TIMEZONE=America/Sao_Paulo

# -------------------------------------------------------------------- LLM ---
# claude-cli  usa o binário `claude` já logado (sem API key)
# anthropic   usa o SDK oficial + ANTHROPIC_API_KEY
# none        sem LLM (só título/descrição da página)
LLM_BACKEND=claude-cli
LLM_MODEL=claude-opus-5
CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=

# -------------------------------------------------------- Enriquecimento ---
# Abre cada link para descobrir do que trata: YouTube via oEmbed (título e
# canal), demais sites via og:/<title> mais o texto central do artigo.
# Desligue se a rede for restrita ou os links forem privados.
ENRICH_LINKS=1
ENRICH_TIMEOUT=10

# ------------------------------------------------------------- Marcação ---
# Reage no Discord ao link que já virou nota, para dar sinal visível de que
# foi arquivado. Exige a permissão "Adicionar reações" no canal.
# Marcar, nunca apagar — ver a seção do README sobre isso.
# Dois estados, dois emojis: um para "entrou no vault agora", outro para
# "isto você já tinha documentado".
MARK_PROCESSED=1
PROCESSED_EMOJI=✅
DUPLICATE_EMOJI=📚

# ------------------------------------------------------------- Histórico ---
# Depois de cada sync, o agendador mastiga um pedaço do passado. 2 dias por
# ciclo de 6h mantém o gasto de LLM baixo e cabe folgado na janela de uso.
DLB_BACKFILL=0
DLB_BACKFILL_DAYS=2
