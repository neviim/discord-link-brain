# ---------------------------------------------------------------- Discord ---
# Bot: crie a aplicação em https://discord.com/developers/applications,
# adicione um Bot, ative "Message Content Intent" e convide-o para o servidor
# com as permissões View Channel + Read Message History.
DISCORD_TOKEN=
DISCORD_TOKEN_TYPE=bot

# Ids dos canais (Discord → Configurações → Avançado → Modo desenvolvedor,
# depois botão direito no canal → Copiar ID). Separados por vírgula.
DISCORD_CHANNEL_IDS=

# Opcional: apelido legível por canal, usado no nome dos arquivos.
# Formato: id:nome,id:nome
DISCORD_CHANNEL_NAMES=

# Opcional: a que servidor cada canal pertence. Formato: id_canal:id_servidor
# O `sync` descobre isto pela API; esta config existe para o `migrar`, que é
# offline por desenho. Sem ela, o link para a mensagem original de captura
# antiga fica como /channels/@me/ e não abre num canal de servidor.
DISCORD_GUILD_IDS=

# --------------------------------------------------------------- Obsidian ---
OBSIDIAN_VAULT=~/Documents/00_Obsidian-dotcom/dotcom
TIMEZONE=America/Sao_Paulo

# -------------------------------------------------------------------- LLM ---
# claude-cli  usa o binário `claude` já logado (sem API key)
# anthropic   usa o SDK oficial + ANTHROPIC_API_KEY
# none        sem LLM (só título/descrição da página)
LLM_BACKEND=claude-cli
LLM_MODEL=claude-opus-5
CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=

# ----------------------------------------------------- Síntese de período ---
# A síntese semanal/mensal roda em backend próprio, e o padrão é o Codex:
# são assinaturas diferentes, e o agendador já disputa a janela de uso de 5h
# da Claude com a classificação diária de cada 6h.
#   codex       usa o binário `codex` já logado (--output-schema garante o JSON)
#   claude-cli  mesmo binário da classificação
#   anthropic   SDK oficial + ANTHROPIC_API_KEY
SINTESE_BACKEND=codex
CODEX_BIN=codex
# SINTESE_MODEL=          # vazio = padrão do backend
SINTESE_TIMEOUT=900

# -------------------------------------------------------- Enriquecimento ---
# Abre cada link para descobrir do que trata: YouTube via oEmbed (título e
# canal), demais sites via og:/<title> mais o texto central do artigo.
# Desligue se a rede for restrita ou os links forem privados.
ENRICH_LINKS=1
ENRICH_TIMEOUT=10

# --------------------------------------------------------- Notas atômicas ---
# Uma nota por link em `50_LINKS/`, com resumo, domínio e um campo `triagem`
# para você classificar depois (inbox → lido → aplicado | descartado).
# Exige que o ESQUEMA.md do vault esteja emendado — ver docs/CONFIGURACAO.md.
# Com 0, o bullet do diário volta a ser rico e nada é escrito em 50_LINKS/.
LINK_NOTES=1

# ------------------------------------------------------------- Marcação ---
# Reage no Discord ao link que já virou nota, para dar sinal visível de que
# foi arquivado. Exige a permissão "Adicionar reações" no canal.
# Marcar, nunca apagar — ver a seção do README sobre isso.
# Dois estados, dois emojis: um para "entrou no vault agora", outro para
# "isto você já tinha documentado".
MARK_PROCESSED=1
PROCESSED_EMOJI=✅
DUPLICATE_EMOJI=📚

# ------------------------------------------------------------- Histórico ---
# Depois de cada sync, o agendador mastiga um pedaço do passado. 2 dias por
# ciclo de 6h mantém o gasto de LLM baixo e cabe folgado na janela de uso.
DLB_BACKFILL=0
DLB_BACKFILL_DAYS=2

# Síntese semanal automática. Sai na segunda, não na sexta: na sexta a semana
# ainda não fechou e a nota nasceria sem os links do fim de semana, para depois
# ser regenerada gastando uma segunda chamada.
DLB_SINTESE=0
DLB_SINTESE_DIA=1
DLB_SINTESE_MES=0

# Ressurgimento: uma vez por dia, 3 links de 30+ dias com o resumo. Não gasta
# modelo — o resumo já existe na nota.
DLB_RESSURGIR=0

# ------------------------------------------------------- Falar no Discord ---
# O bot só reage com emoji até isto ser 1. Escrita no vault é idempotente e
# corrigível reexecutando; mensagem que outro humano leu, não é.
# Exige reconvidar o bot com a permissão 68672 (as três de antes + Enviar
# mensagens). Confira com: python3 -m dlb doctor --testar-envio
DISCORD_POST_ENABLED=0

# `?buscar <pergunta>` no canal. Não é slash command nativo: é polling do que já
# lemos, sem dependência nova e sem porta aberta na máquina.
RESPONDER_PREFIX=?buscar
RESPONDER_INTERVALO=60
RESPONDER_MAX_POR_HORA=10
# Canal separado mantém o de captura limpo. Vazio = os mesmos de DISCORD_CHANNEL_IDS.
RESPONDER_CHANNEL_IDS=

# As marcas do responder NÃO podem colidir com PROCESSED_EMOJI/DUPLICATE_EMOJI —
# o `doctor` falha alto se colidirem.
RESPONDER_EMOJI=💬
RESPONDER_PENDENTE_EMOJI=⏳
RESPONDER_ERRO_EMOJI=❌

# ------------------------------------------------------------------ Busca ---
# Sem embeddings: 70 notas somam ~33 mil caracteres e o corpus inteiro cabe num
# prompt. `doctor` mostra o quanto do orçamento está em uso — quando passar de
# 100%, é hora de considerar embeddings.
BUSCA_BACKEND=lexico-llm
BUSCA_MODEL_BACKEND=codex
BUSCA_MAX_CHARS=120000

# ------------------------------------------------------------------ Temas ---
# Limiar de links para um conceito virar "tema maduro". 8 é o número do
# MOC - Índice do próprio vault.
TEMAS_LIMIAR=8
# Plataformas a ignorar (onde o link mora não é do que ele trata).
TEMAS_IGNORAR=
